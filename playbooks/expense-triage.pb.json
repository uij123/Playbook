{
  "playbook": "expense-triage",
  "version": "0.2.0",
  "description": "Read expenses from my WhatsApp self-chat, match them against the visible Outlook calendar in Chrome, and log one line per expense (date, amount, description, person, sourcing/DD) into a fresh TextEdit document. Selectors captured from the expense-nav recording of 2026-08-27.",
  "inputs": [],
  "credentials": [],
  "steps": [
    {
      "id": "s1",
      "intent": "Open WhatsApp",
      "do": "app.activate",
      "target": {
        "app": "WhatsApp"
      },
      "verify": {
        "frontmost_app": "WhatsApp"
      }
    },
    {
      "id": "s1b",
      "intent": "Close any open overlay in WhatsApp",
      "do": "ui.key",
      "target": {
        "app": "WhatsApp"
      },
      "value": "esc"
    },
    {
      "id": "s1c",
      "intent": "Close a second overlay layer if present",
      "do": "ui.key",
      "target": {
        "app": "WhatsApp"
      },
      "value": "esc"
    },
    {
      "id": "s2a",
      "intent": "Click WhatsApp search",
      "do": "ui.click",
      "target": {
        "app": "WhatsApp",
        "window": {
          "title_contains": "WhatsApp"
        },
        "a11y": {
          "role": "*",
          "description": "Search"
        },
        "fallback_point": {
          "x": 139,
          "y": 97
        }
      },
      "timeout_ms": 8000
    },
    {
      "id": "s2b",
      "intent": "Search for my self-chat",
      "do": "ui.type",
      "value": "Moi"
    },
    {
      "id": "s2c",
      "intent": "Let results appear",
      "do": "wait",
      "value": "900"
    },
    {
      "id": "s2d",
      "intent": "Open the Moi result",
      "do": "ui.click",
      "target": {
        "app": "WhatsApp",
        "window": {
          "title_contains": "WhatsApp"
        },
        "a11y": {
          "role": "*",
          "description": "Moi"
        }
      },
      "timeout_ms": 8000
    },
    {
      "id": "s2e",
      "intent": "Let the conversation load",
      "do": "wait",
      "value": "800"
    },
    {
      "id": "s3",
      "intent": "Read everything visible in WhatsApp",
      "do": "capture",
      "target": {
        "app": "WhatsApp",
        "window": {
          "title_contains": "WhatsApp"
        },
        "a11y": {
          "role": "AXWindow"
        }
      },
      "timeout_ms": 15000,
      "capture": {
        "into": "whatsapp_text",
        "scope": "subtree"
      }
    },
    {
      "id": "s7",
      "intent": "List the receipt messages to open",
      "do": "judge",
      "timeout_ms": 200000,
      "prompt": "The data field whatsapp_text is the accessibility text of my WhatsApp self-chat ('Moi'). Media messages appear with captions like 'Your photo, 15Julyat12:59' or 'Your Live Photo, 14Julyat16:07'. Extract a JSON array (max 3, most recent first) of the distinct PHOTO messages likely to be receipts, each: {\"caption\": \"<verbatim caption substring, 10-60 chars, exactly as written>\", \"date\": \"<date from the caption, e.g. '15 July'>\"}. Exclude PDFs, links, albums with many photos, and UI labels. Output only the JSON array.",
      "input_vars": [
        "whatsapp_text"
      ],
      "into": "media_msgs",
      "output": "json"
    },
    {
      "id": "s4",
      "intent": "Switch to Chrome",
      "do": "app.activate",
      "target": {
        "app": "Google Chrome"
      },
      "verify": {
        "frontmost_app": "Chrome"
      }
    },
    {
      "id": "s5a",
      "intent": "Open Chrome tab search",
      "do": "ui.key",
      "target": {
        "app": "Google Chrome"
      },
      "value": "cmd+shift+a"
    },
    {
      "id": "s5b",
      "intent": "Search my open tabs for Outlook",
      "do": "ui.type",
      "value": "outlook"
    },
    {
      "id": "s5c",
      "intent": "Jump to the signed-in Outlook tab",
      "do": "ui.key",
      "target": {
        "app": "Google Chrome"
      },
      "value": "return",
      "verify": {
        "window_title_contains": "Outlook",
        "wait_ms": 1200
      },
      "timeout_ms": 15000
    },
    {
      "id": "s5e",
      "intent": "Open the Calendar view",
      "do": "ui.click",
      "target": {
        "app": "Google Chrome",
        "window": {
          "title_contains": "Outlook"
        },
        "a11y": {
          "role": "AXImage",
          "description": "Calendar"
        },
        "fallback_point": {
          "x": 26,
          "y": 239
        }
      },
      "verify": {
        "window_title_contains": "Calendar",
        "wait_ms": 1000
      },
      "timeout_ms": 20000
    },
    {
      "id": "s5d",
      "intent": "Let the calendar render",
      "do": "wait",
      "value": "3000"
    },
    {
      "id": "s6",
      "intent": "Read the visible calendar",
      "do": "capture",
      "target": {
        "app": "Google Chrome",
        "window": {
          "title_contains": "Calendar"
        },
        "a11y": {
          "role": "AXWebArea"
        }
      },
      "timeout_ms": 15000,
      "capture": {
        "into": "calendar_text",
        "scope": "subtree"
      }
    },
    {
      "id": "s8",
      "intent": "Open TextEdit for the log",
      "do": "app.activate",
      "target": {
        "app": "TextEdit"
      },
      "verify": {
        "frontmost_app": "TextEdit"
      }
    },
    {
      "id": "s9",
      "intent": "Create a fresh log document",
      "do": "ui.key",
      "target": {
        "app": "TextEdit"
      },
      "value": "cmd+n"
    },
    {
      "id": "s10",
      "intent": "Click into the document",
      "do": "ui.click",
      "target": {
        "app": "TextEdit",
        "window": {
          "title_contains": "Untitled"
        },
        "a11y": {
          "role": "AXTextArea"
        }
      }
    },
    {
      "id": "s11",
      "intent": "Write the header",
      "do": "ui.type",
      "value": "EXPENSE TRIAGE — date | amount | description | person | sourcing/dd"
    },
    {
      "id": "s12",
      "intent": "Open, read, and log each receipt",
      "do": "foreach",
      "items": "{{media_msgs}}",
      "as": "m",
      "steps": [
        {
          "id": "a",
          "intent": "Open the receipt ({{m.caption}})",
          "do": "ui.click",
          "target": {
            "app": "WhatsApp",
            "window": {
              "title_contains": "WhatsApp"
            },
            "a11y": {
              "role": "*",
              "description": "{{m.caption}}"
            }
          },
          "on_fail": "next_item",
          "timeout_ms": 12000
        },
        {
          "id": "a2",
          "intent": "Wait in case it needs to download",
          "do": "wait",
          "value": "2000"
        },
        {
          "id": "a3",
          "intent": "Open it (second click if it was downloading)",
          "do": "ui.click",
          "target": {
            "app": "WhatsApp",
            "window": {
              "title_contains": "WhatsApp"
            },
            "a11y": {
              "role": "*",
              "description": "{{m.caption}}"
            }
          },
          "on_fail": "continue",
          "timeout_ms": 6000
        },
        {
          "id": "b",
          "intent": "Let it open full size",
          "do": "wait",
          "value": "1200"
        },
        {
          "id": "c",
          "intent": "Photograph the opened receipt",
          "do": "capture",
          "target": {
            "app": "WhatsApp",
            "window": {
              "title_contains": "WhatsApp"
            },
            "a11y": {
              "role": "AXWindow"
            }
          },
          "timeout_ms": 12000,
          "capture": {
            "into": "receipt_shot",
            "scope": "screenshot"
          }
        },
        {
          "id": "d",
          "intent": "Read the receipt",
          "do": "judge",
          "timeout_ms": 200000,
          "prompt": "The attached image receipt_shot should show one receipt/document opened full-size in WhatsApp (context caption in field m). If a receipt IS readable, return JSON: {\"amount\": \"<total with currency as printed>\", \"merchant\": \"<vendor name>\", \"date\": \"<date printed, else caption date>\", \"kindhint\": \"<2-4 words>\"}. If the image shows only the chat (no opened receipt), return {\"amount\": \"\", \"merchant\": \"\", \"date\": \"<caption date>\", \"kindhint\": \"receipt not opened\"}. Output only the JSON object.",
          "input_vars": [
            "m",
            "receipt_shot"
          ],
          "into": "r",
          "output": "json"
        },
        {
          "id": "e",
          "intent": "Close the viewer",
          "do": "ui.key",
          "target": {
            "app": "WhatsApp"
          },
          "value": "esc",
          "on_fail": "continue"
        },
        {
          "id": "f",
          "intent": "Classify {{r.kindhint}} as sourcing or dd",
          "do": "judge",
          "timeout_ms": 200000,
          "prompt": "One expense (field r, read off a receipt) and my Outlook calendar text (field calendar_text). 'sourcing' = first meeting a company/founder we might invest in; 'dd' = diligence on an active deal. Using meetings nearest the expense date (default sourcing if nothing matches), answer sourcing or dd.",
          "input_vars": [
            "r",
            "calendar_text"
          ],
          "into": "kind",
          "choices": [
            "sourcing",
            "dd"
          ],
          "model": "claude-sonnet-5"
        },
        {
          "id": "g",
          "intent": "Log {{r.kindhint}}",
          "do": "ui.type",
          "target": {
            "app": "TextEdit",
            "window": {
              "title_contains": "Untitled"
            },
            "a11y": {
              "role": "AXTextArea"
            }
          },
          "value": "\n{{r.date}} | {{r.amount}} | {{r.merchant}} | {{r.kindhint}} | {{kind}}"
        }
      ],
      "max_iterations": 3
    },
    {
      "id": "s13",
      "intent": "Verify the log landed",
      "do": "wait",
      "target": {
        "app": "TextEdit",
        "window": {
          "title_contains": "Untitled"
        },
        "a11y": {
          "role": "AXTextArea"
        }
      },
      "value": "300",
      "verify": {
        "element_value_contains": "|",
        "wait_ms": 300
      }
    }
  ]
}
